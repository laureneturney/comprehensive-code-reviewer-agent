# ccra environment file.
# Copy to .ccra/env (git-ignored). `ccra` sources it before running any tool.
# Every line is optional; uncomment what you use.

# ---------------------------------------------------------------------------
# Git hosting (feeds reviewdog AND pr-agent)
# ---------------------------------------------------------------------------
# GitLab (self-hosted or gitlab.com). Token needs the `api` scope.
#GITLAB_URL=https://gitlab.example.com
#GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
# Set this for pr-agent when reviewing GitLab MRs (reviewdog picks the reporter from --reporter)
#CONFIG__GIT_PROVIDER=gitlab

# GitHub / GitHub Enterprise. Token needs `repo` scope.
#GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
#GITHUB__BASE_URL=https://github.example.com/api/v3   # GHES only

# ---------------------------------------------------------------------------
# LLM for pr-agent (LiteLLM naming: <SECTION>__<KEY>)
# Any OpenAI-compatible gateway works: set OPENAI__API_BASE and prefix the model with openai/
# ---------------------------------------------------------------------------
#CONFIG__MODEL=openai/my-internal-model
#CONFIG__FALLBACK_MODELS=[]
#CONFIG__CUSTOM_MODEL_MAX_TOKENS=128000
#OPENAI__API_BASE=https://llm-gateway.example.com/v1
#OPENAI__KEY=sk-xxxxxxxx
# Anthropic-compatible endpoint instead:
#CONFIG__MODEL=anthropic/claude-sonnet-4-5
#ANTHROPIC__KEY=sk-ant-xxxxxxxx
#ANTHROPIC_BASE_URL=https://anthropic-proxy.example.com
# Local Ollama / vLLM:
#CONFIG__MODEL=ollama/qwen2.5-coder:32b
#OLLAMA__API_BASE=http://localhost:11434

# pr-agent behaviour
#CONFIG__PUBLISH_OUTPUT=true        # false = print to stdout instead of posting to the MR/PR
#CONFIG__VERBOSITY_LEVEL=1

# ---------------------------------------------------------------------------
# LLM for open-code-review (ocr)
# Simplest: three env vars (good for CI). OCR_LLM_PROTOCOL is openai (default) or anthropic.
# ---------------------------------------------------------------------------
#OCR_LLM_URL=https://llm-gateway.example.com/v1
#OCR_LLM_TOKEN=sk-xxxxxxxx
#OCR_LLM_MODEL=my-internal-model
#OCR_LLM_PROTOCOL=openai
#OCR_LLM_TIMEOUT=300                # seconds
# Alternatively ocr keeps a persistent config in ~/.opencodereview/config.json via `ccra ocr config ...`.
# Non-interactive setup for an internal OpenAI-compatible gateway:
#   ccra ocr config set provider my-gateway
#   ccra ocr config set custom_providers.my-gateway.url https://llm-gateway.example.com/v1
#   ccra ocr config set custom_providers.my-gateway.protocol openai
#   ccra ocr config set custom_providers.my-gateway.api_key "$LLM_KEY"
#   ccra ocr config set model my-internal-model
# Built-in providers read their keys from the usual env vars, e.g.:
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Offline safety (set by ccra automatically; listed here for reference)
# ---------------------------------------------------------------------------
#OCR_NO_UPDATE=1                    # stop ocr's background update check
#LITELLM_LOCAL_MODEL_COST_MAP=True  # stop litellm fetching its model map at import
#HF_HUB_OFFLINE=1                   # stop tokenizers reaching HuggingFace

# ponytail default level for agents that honour it: lite | full | ultra | off
#PONYTAIL_DEFAULT_MODE=full
